# TradeSentry 环境配置

# 应用配置
DEBUG=true
APP_NAME=TradeSentry
APP_VERSION=1.0.0

# 服务器配置
HOST=0.0.0.0
PORT=8000

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=trade_sentry

# MongoDB配置
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=trade_sentry

# Redis配置
REDIS_HOST=192.168.31.88
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=tradingagents123

# JWT配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_MINUTES=1440

# 初始资金
INITIAL_BALANCE=10000.0